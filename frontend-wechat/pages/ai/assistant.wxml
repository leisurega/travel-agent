<!-- pages/ai/assistant.wxml -->
<view class="container">
  <view class="chat-header">
    <text class="title">AI旅行助手</text>
  </view>

  <view class="chat-messages">
    <view 
      wx:for="{{messages}}" 
      wx:key="timestamp"
      class="message {{item.type}}"
    >
      <view class="message-avatar">
        <text>{{item.type === 'ai' ? 'AI' : '我'}}</text>
      </view>
      <view class="message-content">
        <text>{{item.content}}</text>
        <text class="message-time">{{item.timestamp}}</text>
      </view>
    </view>
    
    <view wx:if="{{loading}}" class="message ai">
      <view class="message-avatar">AI</view>
      <view class="message-content">
        <text>正在思考...</text>
      </view>
    </view>
  </view>

  <view class="chat-input">
    <input 
      class="input-field"
      placeholder="输入你的问题..."
      value="{{inputValue}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
    />
    <button 
      class="send-btn"
      bindtap="sendMessage"
      disabled="{{loading}}"
    >
      发送
    </button>
  </view>
</view>
