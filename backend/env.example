# 数据库配置
DATABASE_URL=postgresql://travel_user:travel_password@localhost:5432/travel_agent
REDIS_URL=redis://localhost:6379

# Qdrant配置
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Qwen API配置
DASHSCOPE_API_KEY=your_dashscope_api_key

# 腾讯地图API配置
